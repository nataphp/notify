{
    "name": "nataphp/notify",
    "description": "Multi-channel notifications (in-app, email, web push, SMS) for NataPHP",
    "type": "nataphp-plugin",
    "license": "MIT",
    "homepage": "https://github.com/nataphp/notify",
    "authors": [
        {
            "name": "Sérgio Dinis Lopes",
            "homepage": "https://github.com/sergiodlopes"
        }
    ],
    "require": {
        "php": ">=8.1",
        "nataphp/core": "^1.0",
        "minishlink/web-push": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Notify\\": "src/"
        }
    },
    "extra": {
        "nataphp": {
            "bootstrap": true,
            "routes": false
        }
    }
}
